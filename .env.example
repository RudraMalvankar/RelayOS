# Fireworks (existing provider)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=accounts/fireworks/models/deepseek-v4-flash,accounts/fireworks/models/deepseek-v4-pro

# Optional providers. Leave blank to keep them disabled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODELS=
ANTHROPIC_MODELS=

# Runtime limits
RELAYOS_ENV=development
LOCAL_MODEL_PATH=/model/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
MAX_PROMPT_CHARS=12000
TASK_TIMEOUT_SECONDS=28
MAX_CONCURRENT_TASKS=4
MAX_TASK_RECORDS=256
TASK_RETENTION_SECONDS=3600
LOCAL_QUEUE_SIZE=2
LOCAL_INFERENCE_TIMEOUT_SECONDS=18
LOCAL_STARTUP_TIMEOUT_SECONDS=60
LOCAL_RESTART_LIMIT=2
RELAYOS_API_TOKEN=
RATE_LIMIT_PER_MINUTE=60
TELEMETRY_PATH=./output/telemetry.json
MATH_MAX_EXPRESSION_CHARS=1000
MATH_MAX_AST_NODES=100
MATH_MAX_AST_DEPTH=20
MATH_MAX_INTEGER_DIGITS=100
MATH_MAX_EXPONENT=10000
MATH_MAX_RESULT_MAGNITUDE=1e100
CORS_ORIGINS=http://localhost:5173
ENABLE_SEMANTIC_CLASSIFIER=false

# Optional context-efficient routing; disabled by default.
CONTEXT_MANAGEMENT_ENABLED=false
CONTEXT_ROUTING_ENABLED=false
CONTEXT_ROUTING_SHADOW=true
REPOSITORY_ROOT=.
SESSION_STORE_PATH=./output/sessions.json
SESSION_MAX_HISTORY=10
SESSION_SUMMARY_MAX_CHARS=2000
CONTEXT_MAX_CHARS=12000
CONTEXT_MAX_FILES=4
CONTEXT_MAX_FILE_CHARS=4000
ROUTING_CURRENCY=USD
ROUTING_SAFETY_MARGIN=0.10
# Operator-supplied rates per million tokens; leave blank if unverified.
ROUTING_PRICES_JSON=
